# Rohit Portfolio Frontend Environment Configuration

# API Base URL:
# - In local development with Vite proxy: /api/v1
# - In production: /api/v1 (reverse proxied via Nginx/Cloudflare) or full URL (e.g., https://api.aronix.in/api/v1)
VITE_API_URL=/api/v1

# Backend Proxy Target (Only used by Vite dev server during local development)
VITE_BACKEND_URL=http://127.0.0.1:8000
